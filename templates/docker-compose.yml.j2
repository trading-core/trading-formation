# Generated by trading-formation. Do not edit by hand.
# Source: services.yml, resources.yml, templates/docker-compose.yml.j2

services:
  redis:
    image: {{ redis.compose.image }}
    ports:
{% for port in redis.compose.ports %}
      - '{{ port }}'
{% endfor %}
    healthcheck:
      test: {{ redis.compose.healthcheck.test | to_json }}
      interval: {{ redis.compose.healthcheck.interval }}
      timeout: {{ redis.compose.healthcheck.timeout }}
      retries: {{ redis.compose.healthcheck.retries }}
    volumes:
{% for vol in redis.compose.volumes %}
      - {{ vol }}
{% endfor %}
    mem_limit: {{ redis.compose.memory.limit }}
    mem_reservation: {{ redis.compose.memory.reservation }}
    restart: unless-stopped

  postgres:
    image: {{ postgres.compose.image }}
    environment:
{% for k, v in postgres.compose.environment.items() %}
      {{ k }}: {{ v }}
{% endfor %}
    ports:
{% for port in postgres.compose.ports %}
      - '{{ port }}'
{% endfor %}
    healthcheck:
      test: {{ postgres.compose.healthcheck.test | to_json }}
      interval: {{ postgres.compose.healthcheck.interval }}
      timeout: {{ postgres.compose.healthcheck.timeout }}
      retries: {{ postgres.compose.healthcheck.retries }}
      start_period: {{ postgres.compose.healthcheck.start_period }}
    volumes:
{% for vol in postgres.compose.volumes %}
      - {{ vol }}
{% endfor %}
    mem_limit: {{ postgres.compose.memory.limit }}
    mem_reservation: {{ postgres.compose.memory.reservation }}
    restart: unless-stopped

  frontend:
    image: trading-formation-frontend:latest
    build:
      context: ..
      dockerfile: ./trading-formation/frontend/Dockerfile
    env_file:
      - ./frontend/.env
    ports:
      - '{{ frontend.compose.published_port }}:{{ frontend.compose.container_port }}'
    depends_on:
{% for dep in frontend.compose.depends_on %}
      {{ dep.name }}:
        condition: {{ dep.condition | default('service_started') }}
{% endfor %}
    mem_limit: {{ frontend.compose.memory.limit }}
    mem_reservation: {{ frontend.compose.memory.reservation }}
    restart: unless-stopped
{% for key, cfg in services.items() %}
{% set name = key | replace('_', '-') %}

  {{ name }}:
    image: trading-formation-{{ name }}:latest
    build:
      context: ..
      dockerfile: ./trading-formation/backend/Dockerfile
      args:
        SERVICE: {{ name }}
        PORT: {{ cfg.compose.published_port }}
    env_file:
      - ./backend/{{ name }}/.env
    ports:
      - '{{ cfg.compose.published_port }}:{{ cfg.container.port }}'
{% if cfg.compose.depends_on is defined %}
    depends_on:
{% for dep in cfg.compose.depends_on %}
      {{ dep.name }}:
        condition: {{ dep.condition | default('service_started') }}
{% endfor %}
{% endif %}
{% if cfg.compose.volumes is defined %}
    volumes:
{% for vol in cfg.compose.volumes %}
      - {{ vol }}
{% endfor %}
{% endif %}
    mem_limit: {{ cfg.compose.memory.limit }}
    mem_reservation: {{ cfg.compose.memory.reservation }}
    restart: unless-stopped
{% endfor %}

networks:
  default:
    driver: bridge

volumes:
{% for vol in named_volumes %}
  {{ vol }}:
{% endfor %}
