# Generated by trading-formation. Do not edit by hand.
# Contains rendered secrets — gitignored.
#
# Each run-<svc> target picks a free TCP port, writes it to
# trading-formation/.proxy-port-<svc> so run-services.sh can rewrite Traefik's
# dynamic config to route <subdomain>.<domain> -> host.docker.internal:<port>,
# then exec's `go run` with PORT inlined.

PROXY_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST)))/../trading-formation)

define pick_port
$$(python3 -c 'import socket;s=socket.socket();s.bind(("",0));print(s.getsockname()[1]);s.close()')
endef

.PHONY: help
help:
	@echo "Run a backend service on the host (proxy mode):"
{% for target in makefile_targets %}
	@echo "  make run-{{ target.name }}"
{% endfor %}

{% for target in makefile_targets %}
.PHONY: run-{{ target.name }}
run-{{ target.name }}:
	@PORT=$(call pick_port); \
	echo $$PORT > "$(PROXY_DIR)/.proxy-port-{{ target.name }}"; \
	echo "[proxy] {{ target.name }} on host port $$PORT"; \
	trap 'rm -f "$(PROXY_DIR)/.proxy-port-{{ target.name }}"' EXIT; \
	{% for key, value in target.env | dictsort %}{{ key }}='{{ value | string | replace("'", "'\\''") }}' {% endfor %}PORT=$$PORT go run ./{{ target.cmd_dir }}

{% endfor %}
